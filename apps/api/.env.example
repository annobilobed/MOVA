PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://mova:mova@localhost:5432/mova
REDIS_URL=redis://localhost:6379
# Long random string; required in production.
JWT_SECRET=change-me-to-a-long-random-string
# Public web origin (for Paystack callback URL and CORS).
WEB_ORIGIN=http://localhost:3000
# Paystack secret key (sk_test_... or sk_live_...). Leave empty to use the built-in
# test-mode checkout, which simulates Paystack locally and is clearly labelled.
PAYSTACK_SECRET_KEY=
SEAT_LOCK_SECONDS=600
